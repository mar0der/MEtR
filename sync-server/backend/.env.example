APP_NAME="MEtR Sync"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://metr.example.com

LOG_CHANNEL=stack
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=metr_sync
DB_USERNAME=metr_sync
DB_PASSWORD=change-me

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=metr.example.com
SESSION_SECURE_COOKIE=true

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

SANCTUM_STATEFUL_DOMAINS=metr.example.com

# Admin panel credentials (run: php artisan metr:admin:setup <email> <password>)
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
